# ── Telegram ───────────────────────────────────────────────────
# Get from @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user ID (security: bot only responds to you in DM)
# Get from @userinfobot
TELEGRAM_ALLOWED_USER_ID=

# Target Telegram channel where the final video is posted
# Can be numeric ID (e.g. -1001234567890) or public channel username (e.g. @mychannel)
# Make sure your bot is added as an Administrator to this channel with "Post Messages" permission
TELEGRAM_CHANNEL_ID=

# ── Supabase ───────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public storage bucket for uploaded videos (e.g. "reels")
SUPABASE_BUCKET_NAME=reels

# ── Instagram Graph API ────────────────────────────────────────
# Access token with instagram_content_publish permission
IG_ACCESS_TOKEN=

# Numeric Instagram Business or Creator account ID
IG_BUSINESS_ACCOUNT_ID=

# ── Facebook Page ──────────────────────────────────────────────
# Page Access Token (Page-scoped token with pages_manage_posts & pages_read_engagement)
FB_PAGE_ACCESS_TOKEN=

# Numeric Facebook Page ID
FB_PAGE_ID=
